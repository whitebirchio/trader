{
  "name": "@trader/core",
  "version": "0.1.0",
  "private": true,
  "description": "Trader domain core: config, money, schema, audit log, jobs. No Worker/HTTP dependencies.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/db/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:app-role": "tsx scripts/app-role.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@neondatabase/serverless": "^1.2.0",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.1.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "big.js": "^7.0.1",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  }
}
