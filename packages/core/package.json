{
  "name": "@trader/core",
  "version": "0.1.0",
  "private": true,
  "description": "Trader domain core: config, money, schema, audit log, jobs. No Worker/HTTP dependencies.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/db/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:app-role": "tsx scripts/app-role.ts",
    "broker:capture": "tsx scripts/broker-capture.ts",
    "broker:configure": "tsx scripts/broker-configure.ts",
    "broker:smoke": "tsx scripts/broker-smoke.ts",
    "broker:sync": "tsx scripts/broker-sync.ts",
    "routine:fire": "tsx scripts/routine-fire.ts",
    "risk:status": "tsx scripts/risk-status.ts",
    "risk:kill": "tsx scripts/risk-kill.ts",
    "risk:resume": "tsx scripts/risk-resume.ts",
    "risk:check": "tsx scripts/risk-check.ts",
    "notify:test": "tsx scripts/notify-test.ts",
    "notify:preview": "tsx scripts/notify-preview.ts",
    "notify:run": "tsx scripts/notify-run.ts",
    "strategy:submit": "tsx scripts/strategy-submit.ts",
    "strategy:show": "tsx scripts/strategy-show.ts",
    "scorecard:show": "tsx scripts/scorecard-show.ts",
    "research:insiders": "tsx scripts/research-insiders.ts",
    "research:earnings": "tsx scripts/research-earnings.ts",
    "research:momentum": "tsx scripts/research-momentum.ts",
    "research:quality": "tsx scripts/research-quality.ts",
    "research:earnings-universe": "tsx scripts/earnings-universe.ts",
    "rebalance:plan": "tsx scripts/rebalance.ts --mode plan",
    "rebalance:run": "tsx scripts/rebalance.ts --mode run",
    "earnings:refresh": "tsx scripts/earnings-refresh.ts",
    "db:dashboard-role": "tsx scripts/dashboard-role.ts",
    "db:readonly-role": "tsx scripts/readonly-role.ts",
    "db:mcp-role": "tsx scripts/mcp-role.ts",
    "replay": "tsx scripts/replay.ts",
    "replay:data": "tsx scripts/replay-data.ts",
    "replay:export": "tsx scripts/replay-export.ts",
    "capital:status": "tsx scripts/capital-status.ts",
    "capital:withdraw": "tsx scripts/capital-command.ts request",
    "capital:fund-now": "tsx scripts/capital-command.ts fund-now",
    "capital:cancel": "tsx scripts/capital-command.ts cancel"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@neondatabase/serverless": "^1.2.0",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.1.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "big.js": "^7.0.1",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  }
}
