# Owner-role pooled URLs for each Neon branch. Used only from this laptop
# (db:migrate, scripts/set-db-secret.sh) and as GitHub secrets for CI migrations.
# Never give these to the Worker; it uses the trader_app role.
PRODUCTION_MIGRATE_URL='postgresql://neondb_owner:…@ep-…-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require'
STAGING_MIGRATE_URL='postgresql://neondb_owner:…@ep-…-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require'
