{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level is for `wrangler dev` only (reads .dev.vars). Real deploys always
  // name an environment (ADR-005, ADR-006), and the top-level name is
  // deliberately neither of theirs, so a bare `wrangler deploy` can't
  // overwrite production.
  "name": "trader-engine-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Persisted Workers Logs (free tier: 200k events/day, 3-day retention).
  "observability": {
    "enabled": true,
  },
  // No per-version preview hostnames: nothing should reach the engine except
  // through its environment's workers.dev URL.
  "preview_urls": false,
  "triggers": {
    // Must match SCHEDULE in src/index.ts.
    "crons": ["*/15 * * * *"],
  },
  "vars": {
    "TRADING_ENV": "staging",
    "NOTIFY_FROM": "trader@whitebirch.io",
    "NOTIFY_TO": "scott.schmalz@gmail.com",
  },
  // Owner emails (SPEC-notifications). Restricted to the one verified address,
  // so this Worker can't email anyone else. Free via Email Routing.
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "scott.schmalz@gmail.com",
    },
  ],
  // Secrets (`npx wrangler secret put <NAME> --env <env>`):
  //   DATABASE_URL — Neon pooled URL for the trader_app role on that env's branch
  //                  (scripts/set-db-secret.sh; docs/SETUP.md)
  //   ALPACA_KEY_ID, ALPACA_SECRET_KEY — that env's own key pair: paper in staging,
  //                  live in production (scripts/set-alpaca-secret.sh)
  "env": {
    "staging": {
      "name": "trader-engine-staging",
      "vars": {
        "TRADING_ENV": "staging",
        "NOTIFY_FROM": "trader@whitebirch.io",
        "NOTIFY_TO": "scott.schmalz@gmail.com",
      },
      "send_email": [{ "name": "EMAIL", "destination_address": "scott.schmalz@gmail.com" }],
    },
    "production": {
      "name": "trader-engine",
      "vars": {
        "TRADING_ENV": "production",
        "NOTIFY_FROM": "trader@whitebirch.io",
        "NOTIFY_TO": "scott.schmalz@gmail.com",
      },
      "send_email": [{ "name": "EMAIL", "destination_address": "scott.schmalz@gmail.com" }],
    },
  },
}
