{
  "name": "trader-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Trader's read-only dashboard (SPEC-dashboard): Next.js on a Lambda Web Function behind CloudFront. No broker keys, SELECT-only database role.",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mobile:check": "node scripts/mobile-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1161.0",
    "@neondatabase/serverless": "^1.2.0",
    "@trader/core": "*",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.1.0",
    "vitest": "^4.1.12"
  }
}
